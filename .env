BaseURL=
BaseKey=
BaseModel=
# These are defaults. Group members can override base_url/api_key/model
# in config/group_members.json or with /addmember flags.

# Optional skill directory. Defaults to /Your Directory/skill.
# MAS_SKILLS_DIR=/Your Directory/skill

# Optional workspace roots for file and terminal tools.
# Use ":" to separate multiple roots on Linux/macOS.
# MAS_WORKSPACE_ROOTS=/Your Directory

# Optional tool permission policy and JSONL audit sink.
# Dry-run records decisions without blocking. Enforce blocks deny/approval rules.
# MAS_TOOL_PERMISSION_DRY_RUN=0
# MAS_TOOL_PERMISSION_ENFORCE=0
# MAS_TOOL_PERMISSION_RULES=external_effect=approval,workspace_mutating=deny
# MAS_TOOL_AUDIT_JSONL=/Your Directory/project/mas/logs/tool_audit.jsonl
# MAS_GROUP_EVENTS_JSONL=/Your Directory/project/mas/logs/group_events.jsonl
# MAS_USAGE_ENABLED=1

# Optional ReAct/session limits.
# MAS_DEFAULT_MAX_TOKENS=4096
# MAS_DEFAULT_MAX_TURNS=20
# MAS_LLM_TIMEOUT=120
# MAS_ACTIVE_MESSAGE_LIMIT=80
# MAS_HISTORY_MESSAGE_LIMIT=1000
# MAS_MAX_DISPATCH_ROUNDS=100
# Group dispatch policy: default, on_demand, or broadcast_feedback.
# MAS_GROUP_DISPATCH_POLICY=default
# MAS_GROUP_MEMBERS_FILE=/Your Directory/project/mas/config/group_members.json
# Set to 0 to disable whole-run wall-clock timeout.
# MAS_AGENT_RUN_TIMEOUT=0
# MAS_GROUP_RUN_TIMEOUT=0

# Optional file tool output limit. Use 0 in read_file(max_chars=0)
# to read this value.
# MAS_READ_FILE_MAX_CHARS=12000
