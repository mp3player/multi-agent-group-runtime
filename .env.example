# Standalone Agent: OpenAI-compatible provider (required for model requests).
BaseURL=
BaseKey=
BaseModel=

# Required before inference: use the selected model's documented token capacity.
# No capacity is guessed from the model name. Set a positive integer.
MAS_CONTEXT_WINDOW=
# Optional provider input cap (positive integer, still subject to output/reserve budget).
# MAS_CONTEXT_INPUT_LIMIT=
# Private archive directory; default ~/.local/state/mas/context.
# MAS_CONTEXT_ARCHIVE_DIR=
# MAS_CONTEXT_ARCHIVE_QUOTA_BYTES=268435456
# Enable only when the provider supports stream_options.include_usage.
# MAS_LLM_STREAM_USAGE=0
# HTTPX environment settings (proxies and SSL_CERT_FILE/SSL_CERT_DIR) are trusted by default.
# Set 0 for a direct local-provider connection independent of inherited proxy settings.
# MAS_LLM_TRUST_ENV=1
# Optional workaround for Gemma 4's terminal-token SSE leak on vLLM.
# standard preserves provider content; vllm_gemma4 filters only the verified terminal frame.
# MAS_LLM_STREAM_COMPATIBILITY=standard

# Portable defaults: skills/ under the project; workspace root is the current user home directory.
# MAS_SKILLS_DIR=./skills
# MAS_WORKSPACE_ROOTS=.
# Separate multiple workspace roots with the platform path separator (: on Linux/macOS).

# Single-agent configuration. Explicit CLI flags override these settings.
# MAS_ENABLE_TOOLS=1
# MAS_DEFAULT_MAX_TURNS=20
# For longer tasks, explicitly raise this bounded limit (e.g. 150).
# All four execution modes report reaching the limit and retain the final notice.
# MAS_DEFAULT_MAX_TOKENS=4096
# MAS_DEFAULT_TEMPERATURE=0.7
# MAS_LLM_TIMEOUT=120
# MAS_ACTIVE_MESSAGE_LIMIT is accepted for migration but no longer trims messages.
# MAS_HISTORY_MESSAGE_LIMIT=1000
# MAS_AGENT_RUN_TIMEOUT=0
# MAS_PROMPTS_DIR=prompts
# Optional order override; absent files use the common module sequence.
# MAS_PROMPT_ORDER_FILE=order.txt
# MAS_USAGE_ENABLED=1
# CLI console logs go to stderr. Embedded applications configure their own handlers.
# MAS_LOG_LEVEL=INFO
# MAS_READ_FILE_MAX_CHARS=12000
# MAS_ALLOW_UNSAFE_TERMINAL=0

# Optional tool permission policy and JSONL audit sink.
# Decisions are always audited; enforce blocks deny/approval rules.
# Dry-run is a legacy reason label and does not override enforcement.
# MAS_TOOL_PERMISSION_DRY_RUN=0
# MAS_TOOL_PERMISSION_ENFORCE=0
# MAS_TOOL_PERMISSION_RULES=external_effect=approval,workspace_mutating=deny
# MAS_TOOL_AUDIT_JSONL=logs/tool_audit.jsonl
